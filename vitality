		--#region Vitality Section
		Library.Section = function(Self, Params)
			Params = Params or { }

			local Section = {
				Name = Params.Name or Params.name or "Section",
				Side = Params.Side or Params.side or 1,

				Window = Self.Window,
				Page = Self,
				Items = { },
			}

			local Items = { } do
				-- Sections size to their content: a box holding two toggles is two toggles
				-- tall instead of a half-empty panel. Once the elements inside pass
				-- MaxHeight the box stops growing and scrolls its own contents, with the
				-- bar riding the inside of the section's right edge. Pass FullHeight = true
				-- to stretch a section down its column instead, or MaxHeight to give one
				-- section a different ceiling.
				local FullHeight = Params.FullHeight == true
				local MaxHeight = Params.MaxHeight or Params.maxheight or 240
				Items["Section"] = Library:Create("Frame", {
					Name = "\0",
					Parent = Section.Page.ColumnsData[Section.Side].Instance,
					Size = FullHeight and UDim2.new(1, 0, 1, 0) or UDim2.new(1, 0, 0, 35),
					BorderSizePixel = 0,
					AutomaticSize = FullHeight and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
					ClipsDescendants = true,
					BackgroundColor3 = Library.Theme["Section Box"]
				}):AddToTheme({BackgroundColor3 = 'Section Box'})

				Library:Create("UIStroke", {
					Name = "\0",
					Parent = Items["Section"].Instance,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					LineJoinMode = Enum.LineJoinMode.Miter,
					Color = Library.Theme["Outline 1"]
				}):AddToTheme({Color = 'Outline 1'})

				Library:Create("UIStroke", {
					Name = "\0",
					Parent = Items["Section"].Instance,
					ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
					LineJoinMode = Enum.LineJoinMode.Miter,
					Color = Library.Theme["Outline 3"],
					BorderOffset = UDim.new(0, 1)
				}):AddToTheme({Color = 'Outline 3'})

				-- Section header band: a lighter shade of dark behind the title so the
				-- header reads as its own strip, closed off with a hairline rule.
				Items["Header"] = Library:Create("Frame", {
					Name = "\0",
					Parent = Items["Section"].Instance,
					Position = UDim2.new(0, 0, 0, 0),
					Size = UDim2.new(1, 0, 0, 25),
					BorderSizePixel = 0,
					BackgroundColor3 = Library.Theme["Element"]
				}):AddToTheme({BackgroundColor3 = 'Element'})

				-- The tab is shaded top-to-bottom so it sits proud of the box. Half the
				-- previous strength: the bottom edge lands at 0.65 of the top instead of
				-- 0.31, so the lift is still there without the heavy shadow.
				Library:Create("UIGradient", {
					Name = "\0",
					Parent = Items["Header"].Instance,
					Rotation = 90,
					Color = ColorSequence.new{
						ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
						ColorSequenceKeypoint.new(0.5, Color3.fromRGB(218, 218, 218)),
						ColorSequenceKeypoint.new(1, Color3.fromRGB(167, 167, 167))
					}
				})

				Library:Create("Frame", {
					Name = "\0",
					Parent = Items["Header"].Instance,
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new(0, 0, 1, 0),
					Size = UDim2.new(1, 0, 0, 1),
					BorderSizePixel = 0,
					BackgroundColor3 = Library.Theme["Outline 1"]
				}):AddToTheme({BackgroundColor3 = 'Outline 1'})

				Items["Text"] = Library:Create("TextLabel", {
					Name = "\0",
					FontFace = Library.BoldFont,
					TextSize = Library.FontSize,
					Parent = Items["Header"].Instance,
					TextColor3 = Library.Theme["Text"],
					Text = Section.Name,
					AnchorPoint = Vector2.new(0, 0.5),
					Size = UDim2.new(0, 0, 0, 16),
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 7, 0.5, 0),
					BorderSizePixel = 0,
					AutomaticSize = Enum.AutomaticSize.X
				}):AddToTheme({TextColor3 = 'Text'})

				Library:Create("UIStroke", {
					Name = "\0",
					Parent = Items["Text"].Instance
				})

				if FullHeight then
					Items["Content"] = Library:Create("ScrollingFrame", {
						Name = "\0",
						Parent = Items["Section"].Instance,
						Active = true,
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 4, 0, 30),
						Size = UDim2.new(1, -14, 1, -36),
						BorderSizePixel = 0,
						CanvasSize = UDim2.new(0, 0, 0, 0),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						ScrollBarThickness = 2,
						ScrollBarImageColor3 = Library.Theme["Accent"],
						ScrollBarImageTransparency = 0
					}):AddToTheme({ScrollBarImageColor3 = 'Accent'})

					Library:Scrollbar(Items["Content"], {Parent = Items["Section"], Top = 30, Right = 4})
				else
					-- Still sized by its elements, but it is a scroller with a hard ceiling:
					-- past MaxHeight the toggles, keybinds and sliders inside scroll and the
					-- bar appears in the section's own right-hand gutter.
					Items["Content"] = Library:Create("ScrollingFrame", {
						Name = "\0",
						Parent = Items["Section"].Instance,
						Active = true,
						BackgroundTransparency = 1,
						Position = UDim2.new(0, 4, 0, 30),
						Size = UDim2.new(1, -14, 0, 0),
						BorderSizePixel = 0,
						CanvasSize = UDim2.new(0, 0, 0, 0),
						AutomaticCanvasSize = Enum.AutomaticSize.Y,
						AutomaticSize = Enum.AutomaticSize.Y,
						ScrollingDirection = Enum.ScrollingDirection.Y,
						ElasticBehavior = Enum.ElasticBehavior.Never,
						ScrollBarThickness = 0
					})

					Library:Create("UISizeConstraint", {
						Name = "\0",
						Parent = Items["Content"].Instance,
						MaxSize = Vector2.new(math.huge, MaxHeight)
					})

					Library:Scrollbar(Items["Content"], {Parent = Items["Section"], Top = 30, Right = 4})
				end

				Library:Create("UIListLayout", {
					Name = "\0",
					Parent = Items["Content"].Instance,
					Padding = UDim.new(0, 4),
					SortOrder = Enum.SortOrder.LayoutOrder
				})

				if FullHeight then
					Library:Create("UIPadding", {
						Name = "\0",
						Parent = Items["Content"].Instance,
						PaddingRight = UDim.new(0, 0),
						PaddingBottom = UDim.new(0, 6)
					})
				end

				Library:Create("UIPadding", {
					Name = "\0",
					Parent = Items["Section"].Instance,
					PaddingBottom = UDim.new(0, 6)
				})

				Section.Items = Items
			end

			return setmetatable(Section, Library)
		end
