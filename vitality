			["ColorpickerWindow"] = 6
		},

		Theme = nil,

		-- Ignore below
		Threads = { },
		Connections = { },
		SetFlags = { },

		ThemingStuff = { },
		ThemeMap = { },

		OpenFrames = { },

		Holder = nil,
		UnusedHolder = nil,

		Font = nil,
		BoldFont = nil,
	} do
		Library.__index = Library

