						ZIndex = 2,
						BorderSizePixel = 0,
						BackgroundColor3 = Library.Theme["Outline 1"]
					}):AddToTheme({BackgroundColor3 = 'Outline 1'})

					SubItems["Hide2"] = Library:Create("Frame", {
						Name = "\0",
						Parent = SubItems["Inactive"].Instance,
						AnchorPoint = Vector2.new(0, 1),
						Position = UDim2.new(0, -7, 1, 1),
