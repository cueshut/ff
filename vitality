			-- ============================================================
			-- ANTI BLIND / FOG / BLUR
			-- Event-driven now: each effect is destroyed the moment it is added, with a
			-- 1 Hz sweeper as a fallback, instead of polling every Heartbeat.
			-- ============================================================
			local BLIND_NAMES = {
				"DarknessBlind", "LightBlind", "PinkLightBlind", "YellBlurBlind", "RotRoarBlind",
			}
			local BLIND_LOOKUP = {}
			for _, name in ipairs(BLIND_NAMES) do BLIND_LOOKUP[name] = true end

			local function stripEffect(inst)
				if not inst then return end
				local name = inst.Name
				if name == "Atmosphere" or name == "BlurStatusEffect" or BLIND_LOOKUP[name] then
					pcall(function() inst:Destroy() end)
				end
			end

			local function stripEffects()
				for _, child in ipairs(Lighting:GetChildren()) do
					stripEffect(child)
				end
			end

			local antiBlindConn = nil
			local antiBlindSweep = false

			local function SetAntiBlind(on)
				if on then
					stripEffects()
					if not antiBlindConn then
						antiBlindConn = Library:Connect(Lighting.ChildAdded, function(child)
							if Unloaded or not Config.AntiBlind then return end
							task.defer(stripEffect, child)
						end)
					end
					if not antiBlindSweep then
						antiBlindSweep = true
						Library:Thread(function()
							while antiBlindSweep and Config.AntiBlind and not Unloaded do
								stripEffects()
								task.wait(1)
							end
						end)
					end
				else
					if antiBlindConn then antiBlindConn:Disconnect() antiBlindConn = nil end
					antiBlindSweep = false
				end
			end

			-- ============================================================
			-- HIDE NAME
			-- Also event-driven: strips the current gui, then hooks Head.ChildAdded and
			-- re-hooks on every respawn instead of polling every frame.
			-- ============================================================
			local hideNameHeadConn = nil

			local function stripNameGui()
				local char = LocalPlayer.Character
				local head = char and char:FindFirstChild("Head")
				if head then
					local gui = head:FindFirstChild("PlayerNameGui")
