			-- Jump fly: cranking Humanoid.JumpPower only fires you straight up, which is
			-- not useful for getting anywhere. Now a jump request throws the character
			-- along the camera's flat look direction and holds that speed for a moment, so
			-- a jump reads as a short forward dash that glides. Walkspeed feeds into it, so
			-- a faster character launches further.
			local jumpFlyConn = nil
			local jumpFlyBusy = false

			local function jumpFlySpeed()
				local speed = Extra.JumpFlySpeed

				if Config.WalkSpeedEnabled then
					speed = math.max(speed, Config.WalkSpeed * 1.5)
				end

				return math.max(speed, 1)
			end

			local function launchJumpFly()
				if jumpFlyBusy or not getHRP() then return end

				jumpFlyBusy = true

				task.spawn(function()
					local started = os.clock()
					local duration = math.clamp(Extra.JumpFlyTime, 0.05, 3)

					while not Unloaded and Extra.JumpFly and os.clock() - started < duration do
						local part = getHRP()
						if not part then break end

						local cam = Workspace.CurrentCamera
						local look = cam and cam.CFrame.LookVector or part.CFrame.LookVector
						local flat = Vector3.new(look.X, 0, look.Z)

						if flat.Magnitude < 0.01 then
							flat = Vector3.new(part.CFrame.LookVector.X, 0, part.CFrame.LookVector.Z)
						end

						if flat.Magnitude < 0.01 then break end

						local speed = jumpFlySpeed()
						local elapsed = os.clock() - started
						-- a little lift for the first third of the launch, then a flat glide
						local rise = elapsed < duration * 0.35 and speed * 0.3 or speed * 0.05

						pcall(function()
							part.AssemblyLinearVelocity = flat.Unit * speed + Vector3.new(0, rise, 0)
						end)

						task.wait()
					end

					jumpFlyBusy = false
				end)
			end

			local function SetJumpFly(on)
				Extra.JumpFly = on

				if on then
					if jumpFlyConn then return end

					jumpFlyConn = Library:Connect(UserInputService.JumpRequest, function()
						if Unloaded or not Extra.JumpFly then return end
						launchJumpFly()
					end)
				elseif jumpFlyConn then
					jumpFlyConn:Disconnect()
					jumpFlyConn = nil
				end
			end

			registerCleanup(function()
				Extra.JumpFly = false
				jumpFlyBusy = false

				if jumpFlyConn then
					pcall(function() jumpFlyConn:Disconnect() end)
					jumpFlyConn = nil
				end
			end)

