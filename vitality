			log("insanity hooks: " .. (hooksInstalled and "installed" or "unavailable on this executor"), hooksInstalled and "Info" or "Warning")
			notify("juanitahaxx loaded", 3)

		end
		--#endregion
	end
end


-- The demo runs automatically when this file is executed directly. Set
-- This file is the library only. Set getgenv().VITALITY_RUN_GAME_SCRIPT = true
-- before executing it to also run the ported juanitahaxx game script below.
local _RunVitalityGameScript = getgenv().VITALITY_RUN_GAME_SCRIPT == true

if _RunVitalityGameScript then
	local _GameOk, _GameError = pcall(function()
		Library:RunGameScript()
	end)

	if _GameOk then
		print('[Vitality] Game script loaded successfully.')
	else
		warn('[Vitality] Game script failed: '.. tostring(_GameError))
	end
end

getgenv().Library = Library
return Library
