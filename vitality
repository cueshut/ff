			local RARITY_ORDER = { "Common", "Uncommon", "Rare", "Elite", "Legendary", "Mythic", "Relics", "Tomes" }

			local RELIC_NAMES = {
				["Stone Accord"] = true,
				["Idol of Hatred"] = true,
			}

			local RARITY_COLORS = {
				Common    = Color3.fromRGB(255, 255, 255), -- white
				Uncommon  = Color3.fromRGB(70, 220, 90),   -- green
				Rare      = Color3.fromRGB(60, 130, 255),  -- blue
				Elite     = Color3.fromRGB(160, 70, 240),  -- purple
				Legendary = Color3.fromRGB(255, 225, 0),   -- hot yellow
				Mythic    = Color3.fromRGB(255, 45, 45),   -- red
				Relics    = Color3.fromRGB(255, 105, 180), -- pink
				Tomes     = Color3.fromRGB(0, 230, 190),   -- teal
