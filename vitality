			local function applyInstantPrompt(prompt)
				if promptBackup[prompt] == nil then
					promptBackup[prompt] = prompt.HoldDuration
				end
				pcall(function() prompt.HoldDuration = 0 end)
			end

			local function SetInstantPrompts(on)
				Extra.InstantPrompts = on
				if on then
					for _, d in ipairs(Workspace:GetDescendants()) do
						if d:IsA("ProximityPrompt") then applyInstantPrompt(d) end
					end
					if not promptConn then
						promptConn = Library:Connect(Workspace.DescendantAdded, function(d)
							if Unloaded or not Extra.InstantPrompts then return end
							if d:IsA("ProximityPrompt") then applyInstantPrompt(d) end
						end)
					end
					log("instant interact applied to every proximity prompt", "Info")
				else
					if promptConn then
						promptConn:Disconnect()
						promptConn = nil
					end
					for prompt, hold in pairs(promptBackup) do
						if prompt.Parent then
							pcall(function() prompt.HoldDuration = hold end)
						end
