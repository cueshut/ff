			local function saveWaypoint(name)
				local hrp = getHRP()
				if not hrp then
					notify("no character to save", 2)
					return
				end

				name = tostring(name or "")
				name = string.gsub(name, "^%s+", "")
				name = string.gsub(name, "%s+$", "")
				if name == "" then
					name = "waypoint " .. tostring(#WaypointOrder + 1)
				end

				if Waypoints[name] == nil then
					table.insert(WaypointOrder, name)
				end

				local p = hrp.Position
				Waypoints[name] = { p.X, p.Y, p.Z }
				SelectedWaypoint = name
				rebuildWaypointList()
				log(string.format("saved waypoint %s (%.0f, %.0f, %.0f)", name, p.X, p.Y, p.Z), "Info")
				notify("saved " .. name, 2)
			end

			local function deleteWaypoint(name)
				if not name or name == "" or Waypoints[name] == nil then
					notify("no waypoint selected", 2)
					return
				end

				Waypoints[name] = nil
				for i, v in ipairs(WaypointOrder) do
					if v == name then
						table.remove(WaypointOrder, i)
						break
					end
				end

				if SelectedWaypoint == name then SelectedWaypoint = "" end
				rebuildWaypointList()
				log("deleted waypoint " .. name, "Info")
			end

			local function teleportToWaypoint(name)
				local coords = name and name ~= "" and Waypoints[name]
				if not coords then
					notify("no waypoint selected", 2)
					return
