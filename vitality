			local function hookNameGui()
				if hideNameHeadConn then hideNameHeadConn:Disconnect() hideNameHeadConn = nil end
				if not Config.HideName then return end
				local char = LocalPlayer.Character
				local head = char and char:FindFirstChild("Head")
				if head then
					hideNameHeadConn = Library:Connect(head.ChildAdded, function(child)
						if Unloaded or not Config.HideName then return end
