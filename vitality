--[[
	Vitality UI Library
	1:1 recreation of the "Vitality" interface from the reference screenshots.
	Architecture based on the Radiance library (sametlibs / secrethaxx Library.lua).

	Usage:
		local Library = loadstring(game:HttpGet(".../Library.lua"))()
		local Window = Library:Window({ Name = 'Vitality • [UP] Just a baseplate.' })
		local Tab = Window:Page({ Name = "Main" })
		local Section = Tab:Section({ Name = "Section 1", Side = 1 })
		Section:Toggle({ Name = "Toggle", Flag = "toggle1" })
		...
]]

