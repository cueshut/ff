			-- ============================================================
			-- UPDATEINSANITY BLOCKER
			-- ============================================================
			local blockedCount = 0
			local canHook = typeof(hookmetamethod) == "function" and typeof(hookfunction) == "function"

			local function nameMatches(instance)
				if typeof(instance) ~= "Instance" then return false end
				local ok, name = pcall(function() return instance.Name end)
				if not ok or type(name) ~= "string" then return false end
				return string.find(string.lower(name), "insanity", 1, true) ~= nil
			end

			local hooksInstalled = false
			if canHook then
				local ok, err = pcall(function()
					local mtHook
					mtHook = hookmetamethod(game, "__namecall", function(self, ...)
						local method = getnamecallmethod()
						if Config.BlockInsanity
							and (method == "FireServer" or method == "InvokeServer"
								or method == "fireServer" or method == "invokeServer")
							and nameMatches(self) then
							blockedCount += 1
							return
						end
						return mtHook(self, ...)
					end)
					local testRemote = Instance.new("RemoteEvent")
					local oldFire = hookfunction(testRemote.FireServer, newcclosure(function(self, ...)
						if Config.BlockInsanity and nameMatches(self) then
							blockedCount += 1
							return
						end
						return oldFire(self, ...)
					end))
					testRemote:Destroy()
				end)
				hooksInstalled = ok
				if not ok then warn("[insanity] hook installation failed: " .. tostring(err)) end
			else
				warn("[insanity] executor lacks hookmetamethod/hookfunction.")
			end

			-- ============================================================
			-- PLAYER ESP  (sensoryESP)
			-- The lib has no max render distance, so we patch the source string before
			-- loadstring: adds ESPConfig.MaxDistance + a per-target skip. Both patches
			-- are verified - if upstream changes you get a warning instead of silence.
			-- ============================================================
			local ESP = (function()
				local ok, result = pcall(function()
					local src = game:HttpGet("https://raw.githubusercontent.com/rthusrtghdfhtyjkehrfh/sensoryESP/refs/heads/main/ESP.lua")

					local patched
					src, patched = src:gsub(
						"Enabled = false,\n    Keybind = {",
						"Enabled = false,\n    MaxDistance = 0,\n    Keybind = {",
						1
					)
					if patched == 0 then
						warn("[esp] MaxDistance config patch did not match the upstream source")
					end

					src, patched = src:gsub(
						"local distanceStuds = %(Camera%.CFrame%.Position %- rootPart%.Position%)%.Magnitude\n",
						[[local distanceStuds = (Camera.CFrame.Position - rootPart.Position).Magnitude
						if ESPConfig.MaxDistance and ESPConfig.MaxDistance > 0 and distanceStuds > ESPConfig.MaxDistance then
							UpdateESPObj(data.espObj, nil, nil, data.name, distanceStuds, inst, data.Cheap, data.NonHuman, data.NoStatus, data.Config, false)
							continue
						end
			]],
						1
					)
					if patched == 0 then
						warn("[esp] MaxDistance distance-check patch did not match the upstream source")
					end

					return loadstring(src)()
				end)

				if not ok then
					warn("[esp] failed to load sensoryESP: " .. tostring(result))
					return nil
				end

				-- validate before use so a changed upstream fails here, not deep in a toggle
				if type(result) ~= "table" or type(result.Load) ~= "function" or type(result.GetConfig) ~= "function" then
					warn("[esp] sensoryESP returned an unexpected value")
					return nil
				end

				return result
			end)()

			if ESP then
				pcall(function()
					ESP:Load({
						Enabled = false,
						Players = true,
						LocalPlayer = false,
						LimitFPS = 0,
						DynamicBoxes = false, -- static, stable boxes
						Boxes = true,
						BoxColor = Color3.fromRGB(255, 255, 255),
						Names = true,
						TextColor = Color3.fromRGB(255, 255, 255),
						TextOutline = false,
						HealthBar = { Enabled = true, ShowText = false },
						Skeleton = { Enabled = false, Color = Color3.fromRGB(255, 255, 255) },
						Distance = { Enabled = true, Unit = "Studs", Ending = "m" },
						Chams = { Enabled = false, Type = "Highlight" },
					})
				end)
			end

