			local function normalizeRarity(value)
				if type(value) ~= "string" then return nil end
				local lower = string.lower(value)
				for _, rarity in ipairs(RARITY_ORDER) do
					if string.lower(rarity) == lower then
						return rarity
					end
				end
				return nil
			end

			local function getRarity(model)
				-- name-based categories first
				if string.find(model.Name, "Enhancement Tome", 1, true) then return "Tomes" end
				if RELIC_NAMES[model.Name] then return "Relics" end
				local ok, value = pcall(function() return model:GetAttribute("Rarity") end)
				if ok then
					local r = normalizeRarity(value)
					if r then return r end
				end
				for _, d in ipairs(model:GetDescendants()) do
					local ok2, v2 = pcall(function() return d:GetAttribute("Rarity") end)
					if ok2 then
						local r = normalizeRarity(v2)
						if r then return r end
					end
				end
				return "Common"
			end

			-- multi-dropdowns hand back an array {"Common", ...}
			local function applyRaritySelection(selected, filterTable)
				for _, rarity in ipairs(RARITY_ORDER) do filterTable[rarity] = false end
				if type(selected) == "table" then
					for _, name in ipairs(selected) do
						local r = normalizeRarity(name)
						if r then filterTable[r] = true end
					end
				elseif type(selected) == "string" then
					local r = normalizeRarity(selected)
					if r then filterTable[r] = true end
				end
			end

			-- ============================================================
			-- FLY (position-based)
			-- ============================================================
			local flyConnection = nil
			local flyPos = nil

			local function keyDown(key)
				if UserInputService:GetFocusedTextBox() then return false end
				return UserInputService:IsKeyDown(key)
			end

			local function stopFly()
				if flyConnection then flyConnection:Disconnect() flyConnection = nil end
				flyPos = nil
				local humanoid = getHumanoid()
				if humanoid then humanoid.PlatformStand = false end
				-- zero leftover velocity so you do not keep drifting after landing
				local hrp = getHRP()
				if hrp then
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end
			end

			local function startFly()
				stopFly()
				local hrp = getHRP()
				flyPos = hrp and hrp.Position or nil

				flyConnection = Library:Connect(RunService.Heartbeat, function(dt)
					local hrp = getHRP()
					local humanoid = getHumanoid()
					local cam = Workspace.CurrentCamera
					if Unloaded or not Config.Fly then return end
					if not (hrp and humanoid and cam) then flyPos = nil return end
					-- clamp delta time: on a lag spike a raw dt would fling you across the map
					dt = math.min(dt, 0.1)
					if not flyPos or (hrp.Position - flyPos).Magnitude > 60 then
						flyPos = hrp.Position
					end
					if not humanoid.PlatformStand then humanoid.PlatformStand = true end
					local camCF = cam.CFrame
					local look = camCF.LookVector
					local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
					flatRight = flatRight.Magnitude > 0.001 and flatRight.Unit or Vector3.zero
					local move = Vector3.zero
					if keyDown(Enum.KeyCode.W) then move += look end
					if keyDown(Enum.KeyCode.S) then move -= look end
					if keyDown(Enum.KeyCode.A) then move -= flatRight end
					if keyDown(Enum.KeyCode.D) then move += flatRight end
					if keyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
					if keyDown(Enum.KeyCode.LeftShift) then move -= Vector3.new(0, 1, 0) end
					if move.Magnitude > 0.001 then
						flyPos = flyPos + move.Unit * (Config.FlySpeed * dt)
					end
					hrp.CFrame = CFrame.new(flyPos) * hrp.CFrame.Rotation
					hrp.AssemblyLinearVelocity = Vector3.zero
					hrp.AssemblyAngularVelocity = Vector3.zero
				end)
			end

			local function SetFly(on)
				if on then startFly() else stopFly() end
			end

			-- ============================================================
			-- TELEPORTS (server-desync method)
			-- ============================================================
			local Teleporting = false

			local function teleportTo(x, y, z)
				if Teleporting then return end -- button spam can no longer stack anchors
				Teleporting = true
				task.spawn(function()
					local ok, err = pcall(function()
						local char = LocalPlayer.Character
						local hrp = char and char:FindFirstChild("HumanoidRootPart")
						if not hrp then return end
						local target = CFrame.new(x, y, z)

						local wasFlying = Config.Fly
						if wasFlying then stopFly() end

						hrp.Anchored = true
						task.wait(0.2)
						pcall(function() CustomizationRemote:FireServer("Close") end)
						task.wait(0.1)

						for _ = 1, 30 do
							if Unloaded or not hrp.Parent then break end
							hrp.CFrame = target
							hrp.AssemblyLinearVelocity = Vector3.zero
							hrp.AssemblyAngularVelocity = Vector3.zero
							RunService.Heartbeat:Wait()
						end

						-- always reached, even after a break above, so Anchored never gets stuck
						if hrp.Parent then hrp.Anchored = false end

						for _ = 1, 12 do
							if Unloaded or not hrp.Parent then break end
							hrp.CFrame = target
							hrp.AssemblyLinearVelocity = Vector3.zero
							RunService.Heartbeat:Wait()
						end

						if wasFlying and not Unloaded and hrp.Parent then startFly() end
					end)
					Teleporting = false
					if not ok then warn("[teleport] " .. tostring(err)) end
				end)
			end

