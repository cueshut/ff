			local function rebuildTrinketTPList()
				TrinketTPMap = {}
				local names = {}
				for model, esp in pairs(DropESPObjects) do
					if model.Parent and TPRarityFilter[esp.rarity] then
						local display = model.Name
						local n = 2
						while TrinketTPMap[display] do
							display = model.Name .. " (" .. n .. ")"
							n += 1
						end
						TrinketTPMap[display] = model
						table.insert(names, display)
					end
				end
				table.sort(names)
				pcall(function() TrinketTPDropdown:Refresh(names) end)
			end

