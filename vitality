					BorderSizePixel = 0
				}):AddToTheme({TextColor3 = 'Text'})

				Library:Create("UIStroke", {
					Name = "\0",
					Parent = Items["Text"].Instance
				})
			end

			local function Position()
				local Box = Object.AbsolutePosition
				local Extent = Object.AbsoluteSize

				local X = Box.X + Extent.X + 8
				local Y = Box.Y + Extent.Y / 2

				local Viewport = (Camera or workspace.CurrentCamera).ViewportSize
				local Size = Items["Tooltip"].Instance.AbsoluteSize

				if X + Size.X > Viewport.X - 4 then
					X = math.max(Box.X - Size.X - 8, 4)
				end

				Items["Tooltip"].Instance.Position = UDim2.new(0, X, 0, Y - Size.Y / 2)
			end

			Object:OnHover(function()
				Position()

				Items["Tooltip"].Instance.Visible = true
				Items["Tooltip"].Instance.BackgroundTransparency = 1
				Items["Text"].Instance.TextTransparency = 1

				Items["Tooltip"]:Tween({BackgroundTransparency = 0}, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
				Items["Text"]:Tween({TextTransparency = 0}, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
			end, function()
				Items["Tooltip"]:Tween({BackgroundTransparency = 1}, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
				Items["Text"]:Tween({TextTransparency = 1}, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)).Completed:Connect(function(State)
					if State == Enum.PlaybackState.Completed then
						Items["Tooltip"].Instance.Visible = false
					end
				end)
			end)

			return Items["Tooltip"]
		end
