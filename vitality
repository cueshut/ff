					self.dot.Visible = false
					self.dotOutline.Visible = false
					self.tracer.Visible = false
				end

				function esp:Update()
					if Unloaded or not Config.DropESP then self:Hide() return end
					if not DropRarityFilter[self.rarity] then self:Hide() return end
					local h = self.handle
					if not (h and h.Parent and self.model.Parent) then self:Hide() return end
					local pos = h:IsA("Attachment") and h.WorldPosition or h.Position

					if Camera then
						local dist = (pos - Camera.CFrame.Position).Magnitude
						if dist > Config.ESPDistance then self:Hide() return end
					end

					local screen, onScreen = w2s(pos)
					if not (screen and onScreen) then self:Hide() return end

					local color = RARITY_COLORS[self.rarity] or RARITY_COLORS.Common

					self.dotOutline.Position = screen - Vector2.new(3.5, 3.5)
					self.dotOutline.Size = Vector2.new(7, 7)
					self.dotOutline.Visible = true

					self.dot.Position = screen - Vector2.new(2.5, 2.5)
					self.dot.Size = Vector2.new(5, 5)
					self.dot.Color = color
					self.dot.Visible = true

					local text = self.model.Name .. "  [" .. self.rarity .. "]"

					if Extra.DropDistance and Camera then
						local dist = (pos - Camera.CFrame.Position).Magnitude
						text = text .. "  " .. tostring(math.floor(dist)) .. "m"
					end

					self.label.Text = text
					self.label.Size = Extra.DropTextSize
					self.label.Position = screen + Vector2.new(0, 10)
					self.label.Color = color
					self.label.Visible = true

					-- tracer runs from the bottom middle of the screen to the drop
					if Extra.DropTracers and Camera then
						local vp = Camera.ViewportSize
						self.tracer.From = Vector2.new(vp.X / 2, vp.Y)
						self.tracer.To = screen
						self.tracer.Color = Extra.TracerColor
						self.tracer.Visible = true
					else
						self.tracer.Visible = false
					end
				end

				function esp:Destroy()
					self:Hide()
					if self.rarityConn then self.rarityConn:Disconnect() self.rarityConn = nil end
					self.label:Remove()
					self.dot:Remove()
					self.dotOutline:Remove()
					self.tracer:Remove()
				end

				DropESPObjects[model] = esp
			end

			local function removeDropESP(model)
				local esp = DropESPObjects[model]
				if esp then
					esp:Destroy()
					DropESPObjects[model] = nil
				end
			end

			local function clearDropESP()
				for model in pairs(DropESPObjects) do
					removeDropESP(model)
				end
			end

			local function refreshDropESP()
				local drops = Workspace:FindFirstChild(DROPS_FOLDER_NAME)
				if not drops then return end
				-- prune entries whose model left the folder (ChildRemoved can be missed)
				for model in pairs(DropESPObjects) do
					if model.Parent ~= drops then
						removeDropESP(model)
					end
				end
				for _, model in ipairs(drops:GetChildren()) do
					if not DropESPObjects[model] then
						createDropESP(model)
					end
				end
			end

			-- Fixed: the original only hooked ChildAdded/ChildRemoved when workspace.Drops
			-- already existed at exec time, so drops stopped being tracked if the folder
			-- spawned later. Now the folder is watched whenever it appears, and ESP is
			-- cleared when it is removed.
			local dropsFolderConns = {}

			local function unwatchDropsFolder()
				for _, conn in ipairs(dropsFolderConns) do
					conn:Disconnect()
				end
				table.clear(dropsFolderConns)
			end

			local function watchDropsFolder(folder)
				unwatchDropsFolder()
				table.insert(dropsFolderConns, Library:Connect(folder.ChildAdded, function(child)
					if Unloaded then return end
					createDropESP(child)
				end))
				table.insert(dropsFolderConns, Library:Connect(folder.ChildRemoved, function(child)
					removeDropESP(child)
				end))
				refreshDropESP()
			end

			do
				local drops = Workspace:FindFirstChild(DROPS_FOLDER_NAME)
				if drops then watchDropsFolder(drops) end

				Library:Connect(Workspace.ChildAdded, function(child)
					if Unloaded then return end
					if child.Name == DROPS_FOLDER_NAME then
						watchDropsFolder(child)
					end
				end)
				Library:Connect(Workspace.ChildRemoved, function(child)
					if child.Name == DROPS_FOLDER_NAME then
						unwatchDropsFolder()
						clearDropESP()
					end
				end)
			end

